# roomscan-wifi-travel.nmconnection.tmpl
#
# Wi-Fi client profile for the "travel" network (e.g. a mobile hotspot or
# hotel AP). See roomscan-wifi-home.nmconnection.tmpl for the general
# design notes; this file mirrors it with the travel-specific tokens.
#
# Placeholders substituted by the image builder:
#   {{TRAVEL_UUID}}      -- fixed UUID for this connection profile, stable
#                            across rebuilds
#   {{TRAVEL_SSID}}      -- the travel Wi-Fi network's SSID, verbatim
#   {{TRAVEL_PSK}}       -- the travel Wi-Fi network's WPA-PSK passphrase
#   {{TRAVEL_PRIORITY}}  -- integer autoconnect-priority (higher wins;
#                            typically lower than {{HOME_PRIORITY}} so home
#                            is preferred when both are in range)
#   {{WIFI_COUNTRY}}     -- ISO 3166-1 alpha-2 regulatory domain, shared
#                            with the home profile (see that file's notes;
#                            documentary only in this file)
#
# Band is intentionally left unset: the Pi 3 Model B's onboard radio
# (BCM43438) is 2.4 GHz only.
#
# The builder renders this file to roomscan-wifi-travel.nmconnection before
# packaging; install.sh only installs already-rendered *.nmconnection files.

[connection]
id=roomscan-wifi-travel
uuid={{TRAVEL_UUID}}
type=wifi
interface-name=wlan0
autoconnect=true
autoconnect-priority={{TRAVEL_PRIORITY}}
# 0 = retry forever (NetworkManager's own documented meaning; -1/unset means
# "use the global default", which is 4 tries then give up permanently until
# something else pokes the device). Unset here is what let wlan0 sit
# `disconnected` for 30+ minutes after a transient AP-side handshake glitch
# on 2026-08-19 (issue #200) -- NM had already exhausted its retry budget
# and stopped trying long before anyone noticed. roomscan-bridge-reconcile's
# own wlan0 self-heal (10s poll) is a second, faster layer on top of this,
# not a substitute for it -- this fixes why NM's own mechanism gave up.
autoconnect-retries=0

[wifi]
mode=infrastructure
ssid={{TRAVEL_SSID}}
# country={{WIFI_COUNTRY}}
powersave=2

[wifi-security]
key-mgmt=wpa-psk
psk={{TRAVEL_PSK}}

[ipv4]
method=auto

[ipv6]
method=auto

[proxy]
