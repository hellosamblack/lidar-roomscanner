[Unit]
Description=roomscan bridge -- bounded pcap ring of the scanner's UDP stream on eth0
# Structurally fail-open: this unit is a passive observer via tcpdump, not
# a component the data path depends on. The kernel forwards eth0<->wlan0
# UDP/{{STREAM_PORT}} traffic via the nftables NAT rules regardless of
# whether this service is running, enabled, installed, or crash-looping.
# Nothing reads from it synchronously; it exists purely so a post-hoc pcap
# ring is available for diagnosing a bad capture after the fact.
After=network-online.target
Wants=network-online.target
# Bound the restart loop. Without this, a tee that cannot start for a
# structural reason (see the ExecStartPre below -- it could not write its own
# ring directory) retries every 5 seconds forever, which on the real Pi meant
# a permanently failing unit generating journal churn from first boot with
# nothing ever escalating it. Five attempts in five minutes, then it stays
# down and is visible as `failed` -- and roomscan-bridge-reconcile brings it
# back on its next pass if the cause has cleared.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Nice=5

# Why this unit runs AS tcpdump rather than as root.
#
# tcpdump drops privileges to the unprivileged `tcpdump` user right after it
# opens the capture socket -- that is its security model, not something the
# command line here turns on. Run as root, the post-drop process could not
# create its own ring files in the root-owned state directory:
#
#   tcpdump: /var/lib/roomscan-bridge/tee/ring.pcap00: Permission denied
#
# and the unit crash-looped every 5 s from first boot (issue #191).
#
# Handing the directory over from an ExecStartPre does NOT fix this, which was
# measured on the real Pi rather than assumed: `install -d -o tcpdump` sets it
# to tcpdump:tcpdump 0750 and exits 0, and the very next `systemctl restart`
# shows it back at root:root 0755. StateDirectory= re-asserts ownership
# matching the unit's User= on EVERY start, and wins over anything ExecStartPre
# did. Fighting it is futile; the fix is to declare the owner we actually want.
#
# With User=tcpdump, systemd creates and maintains the state directory owned by
# tcpdump, and the ambient capability replaces the root privileges tcpdump
# needed only in order to open the interface: CAP_NET_RAW for the packet
# socket, CAP_NET_ADMIN for promiscuous mode (kept rather than passing -p, so
# capture semantics do not change along with the ownership fix).
User=tcpdump
Group=tcpdump
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
StateDirectory=roomscan-bridge/tee
StateDirectoryMode=0750
ExecStart=/usr/bin/tcpdump -i eth0 -n -s 0 'udp port {{STREAM_PORT}}' -w /var/lib/roomscan-bridge/tee/ring.pcap -C 100 -W 20
Restart=on-failure
RestartSec=5
# Bounded ring: 100 MB files x 20 = 2 GB max on disk, ~70 min of capture at
# the measured ~466 KB/s stream rate.

[Install]
WantedBy=multi-user.target
