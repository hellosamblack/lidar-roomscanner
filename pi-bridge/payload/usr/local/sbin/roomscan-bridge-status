#!/bin/bash
# roomscan-bridge-status -- emit a single JSON object on stdout describing
# the current state of the roomscan Wi-Fi<->eth0 bridge. This is the single
# source of truth the MCP `bridge_status` tool consumes.
#
# Deliberately NOT `set -e`: a status script must report partial truth
# (nulls for whatever it could not determine) rather than die partway
# through and report nothing. `-u` and `pipefail` are kept since those
# catch real bugs (typo'd variable names, a broken pipeline) without
# punishing an individual command's expected nonzero exit.
#
# All shelling-out is done here in bash; the actual JSON construction is
# delegated to python3 (guaranteed present on Raspberry Pi OS Lite) via
# `python3 -c` with every value passed as argv, never via a stdin heredoc
# (a heredoc here would be harmless since nothing else reads stdin, but
# argv keeps this script safe to refactor without re-litigating that).

set -uo pipefail

# Every privileged probe below (`iw`, `nft`) lives in /usr/sbin, which is NOT
# on a non-root login PATH on Debian/Raspberry Pi OS. `bridge_status` reaches
# this script over ssh as the unprivileged bridge account, so on the first
# real Pi every one of those probes died with `command not found` (issue
# #191) -- and, worse, the failures were indistinguishable from real
# readings: the script reported `wlan0 connected: false, ssid: null` for an
# interface that was associated and carrying a lease, and `nft rules: []`
# for a loaded ruleset. See the null-vs-false handling further down; this
# line is the half that makes the probes work at all.
PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH}"
export PATH

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Pull in node-identity defaults (SCANNER_IP, STREAM_PORT, ...),
# overridden by /etc/roomscan-bridge/node.env when present. Same
# resolution order as roomscan-bridge-reconcile: next to this script
# first, then the installed location, then inline fallback defaults so
# this script still runs standalone if the shared lib is missing.
if [ -f "${SELF_DIR}/roomscan-bridge-common.sh" ]; then
    # shellcheck disable=SC1091
    . "${SELF_DIR}/roomscan-bridge-common.sh"
elif [ -f /usr/local/sbin/roomscan-bridge-common.sh ]; then
    # shellcheck disable=SC1091
    . /usr/local/sbin/roomscan-bridge-common.sh
else
    : "${SCANNER_IP:=172.31.100.20}"
    : "${STREAM_PORT:=5000}"
    [ -f /etc/roomscan-bridge/node.env ] && . /etc/roomscan-bridge/node.env
fi

# A probe that could not run must report "I do not know" (null), never the
# reading it would have produced on a healthy box. `iw` missing from PATH
# used to yield WLAN0_CONNECTED=no -- a confident false, for a link that was
# up. An absent answer that reads as a real negative sends the next session
# chasing a fault that does not exist. Same class as the |B| magnetometer
# check in AGENTS.md: ask what wrong answers the check can actually see.
have() {
    command -v "$1" >/dev/null 2>&1
}

# nft needs root; run under sudo -n when we are not root and the grant is
# there (it is -- /etc/sudoers.d/roomscan-bridge). NFT_OK records whether the
# ruleset was actually READ, so an unreadable table is reported as null
# rather than as an empty ruleset, which would look exactly like "nftables is
# loaded and has no rules" -- the symptom of a genuinely broken bridge.
NFT_OK="no"
NFT_RAW=""
# Sets the globals NFT_RAW/NFT_OK rather than printing, and is therefore
# called as a bare `nft_get`, NOT as `$(nft_get)`. Command substitution runs
# the function in a subshell, so a flag assigned inside it would be discarded
# on return and NFT_OK would read "no" forever -- the exact shape of bug this
# flag exists to prevent.
nft_get() {
    local out=""
    if ! have nft; then
        return 0
    fi
    if [ "$(id -u)" -eq 0 ]; then
        out="$(nft list table ip roomscan_bridge 2>/dev/null)" || return 0
    else
        out="$(sudo -n nft list table ip roomscan_bridge 2>/dev/null)" || return 0
    fi
    [ -n "${out}" ] || return 0
    NFT_OK="yes"
    NFT_RAW="${out}"
}

# --- host -------------------------------------------------------------
MODEL="$(cat /proc/device-tree/model 2>/dev/null | tr -d '\0')"
HOSTNAME_VAL="$(hostname 2>/dev/null)"
UPTIME_S="$(awk '{print int($1)}' /proc/uptime 2>/dev/null)"

# --- wlan0 --------------------------------------------------------------
# WLAN0_CONNECTED is deliberately tri-state: "yes", "no", or "" meaning the
# question could not be asked (iw absent). yesno() maps "" to JSON null.
IW_LINK=""
IW_POWERSAVE=""
WLAN0_CONNECTED=""
if have iw; then
    IW_LINK="$(iw dev wlan0 link 2>/dev/null)"
    IW_POWERSAVE="$(iw dev wlan0 get power_save 2>/dev/null)"
    WLAN0_CONNECTED="no"
    if printf '%s' "${IW_LINK}" | grep -q '^Connected to'; then
        WLAN0_CONNECTED="yes"
    fi
fi
WLAN0_SSID="$(printf '%s' "${IW_LINK}" | grep -oP 'SSID:\s*\K.*' || true)"
WLAN0_RSSI="$(printf '%s' "${IW_LINK}" | grep -oP 'signal:\s*\K-?[0-9]+' || true)"
WLAN0_BITRATE="$(printf '%s' "${IW_LINK}" | grep -oP 'tx bitrate:\s*\K[0-9.]+' || true)"
WLAN0_POWERSAVE="$(printf '%s' "${IW_POWERSAVE}" | grep -oP 'Power save:\s*\K\S+' || true)"
WLAN0_IPV4="$(ip -4 -o addr show wlan0 2>/dev/null | awk '{print $4; exit}')"

# --- eth0 -----------------------------------------------------------------
ETH0_CARRIER="$(cat /sys/class/net/eth0/carrier 2>/dev/null || true)"
ETH0_IPV4="$(ip -4 -o addr show eth0 2>/dev/null | awk '{print $4; exit}')"
ETH0_NEIGH="$(ip neigh show "${SCANNER_IP}" dev eth0 2>/dev/null | awk '{print $NF; exit}')"
LEASES_RAW="$(cat /var/lib/misc/dnsmasq.leases 2>/dev/null)"

# --- nftables ---------------------------------------------------------
nft_get

# --- tee ring ---------------------------------------------------------
TEE_ACTIVE="$(systemctl is-active roomscan-tee.service 2>/dev/null || true)"
RING_DIR="/var/lib/roomscan-bridge/tee"

# The ring directory is owned by `tcpdump` and mode 0750 -- roomscan-tee runs
# as that user so systemd's StateDirectory= maintains it correctly (see
# roomscan-tee.service). The consequence is that THIS script, running over ssh
# as the unprivileged bridge account, cannot list it: `ls` fails, and the old
# unguarded `ls | wc -l` turned that into a confident `0 files, 0 MB` for a ring
# holding 33 MB of captured stream. A reading of zero here is the operator's
# signal that frames are unrecoverable, so inventing one is worse than
# admitting ignorance (issue #191).
#
# So: read it with sudo when not root (same as the nft probe), and if that is
# not possible, report null rather than zero.
TEE_READABLE="no"
RING_FILES_COUNT=""
RING_BYTES=""
RING_NEWEST=""
RING_OLDEST=""
# `sudo -n` only when we are not already root; `ls -t <dir>` exits nonzero if
# the directory cannot be read, which is exactly the signal we need.
as_root() {
    if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo -n "$@"; fi
}
if ring_names="$(as_root ls -t "${RING_DIR}" 2>/dev/null)"; then
    TEE_READABLE="yes"
    files="$(printf '%s\n' "${ring_names}" | grep '^ring\.pcap' || true)"
    RING_FILES_COUNT="$(printf '%s' "${files}" | grep -c . || true)"
    RING_BYTES=0
    if [ -n "${files}" ]; then
        RING_NEWEST="$(printf '%s\n' "${files}" | head -1)"
        RING_OLDEST="$(printf '%s\n' "${files}" | tail -1)"
        RING_BYTES="$(as_root du -sb "${RING_DIR}" 2>/dev/null | awk '{print $1}')"
    fi
fi

# --- units --------------------------------------------------------------
UNITS_LIST="dnsmasq.service avahi-daemon.service nftables.service roomscan-tee.service roomscan-bridge-reconcile.timer roomscan-bridge-healthlog.timer"
UNITS_RAW=""
for u in ${UNITS_LIST}; do
    state="$(systemctl is-active "${u}" 2>/dev/null || true)"
    # NRestarts is the difference between "starting up" and "crash-looping".
    # A unit sampled mid-backoff reports `activating`, which reads as healthy
    # -- roomscan-tee looked exactly like that on the first real Pi while
    # failing every 5 seconds since boot. The restart counter is the
    # observable that tells those two apart in a single reading.
    restarts="$(systemctl show -p NRestarts --value "${u}" 2>/dev/null || true)"
    UNITS_RAW="${UNITS_RAW}${u}=${state}=${restarts}
"
done

# --- thermal / throttle ------------------------------------------------
TEMP_C="$(awk '{printf "%.1f", $1/1000}' /sys/class/thermal/thermal_zone0/temp 2>/dev/null || true)"
THROTTLED="$(vcgencmd get_throttled 2>/dev/null | grep -oP 'throttled=\K\S+' || true)"

# --- NTP ------------------------------------------------------------------
NTP_SYNCED="$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)"

python3 -c '
import json
import re
import sys

(
    model, hostname_val, uptime_s,
    wlan0_ssid, wlan0_rssi, wlan0_bitrate, wlan0_powersave, wlan0_ipv4, wlan0_connected,
    eth0_carrier, eth0_ipv4, eth0_neigh, leases_raw,
    nft_raw, nft_ok,
    tee_active, ring_files_count, ring_bytes, ring_newest, ring_oldest, tee_readable,
    units_raw,
    temp_c, throttled, ntp_synced,
    scanner_ip, stream_port,
) = sys.argv[1:28]


def s(v):
    v = v.strip()
    return v if v else None


def i(v):
    v = v.strip()
    if not v:
        return None
    try:
        return int(v)
    except ValueError:
        return None


def f(v):
    v = v.strip()
    if not v:
        return None
    try:
        return float(v)
    except ValueError:
        return None


def b01(v):
    v = v.strip()
    if v == "1":
        return True
    if v == "0":
        return False
    return None


def yesno(v):
    v = v.strip().lower()
    if v == "yes":
        return True
    if v == "no":
        return False
    return None


scanner_lease = None
for line in leases_raw.splitlines():
    parts = line.split()
    if len(parts) >= 3 and parts[2] == scanner_ip:
        scanner_lease = {
            "expiry": s(parts[0]),
            "mac": s(parts[1]),
            "ip": s(parts[2]),
        }
        break

nft_rules = []
dnat_target = None
rule_re = re.compile(
    r"counter packets (\d+) bytes (\d+).*?comment \"([^\"]+)\""
)
dnat_re = re.compile(r"dnat to ([0-9.]+):" + re.escape(stream_port))
for line in nft_raw.splitlines():
    m = rule_re.search(line)
    if not m:
        continue
    packets, bytes_, name = m.groups()
    nft_rules.append({"name": name, "packets": int(packets), "bytes": int(bytes_)})
    if name == "roomscan-dnat-to-scanner":
        dm = dnat_re.search(line)
        if dm:
            dnat_target = dm.group(1)

units = {}
unit_restarts = {}
for line in units_raw.splitlines():
    if "=" not in line:
        continue
    name, _, rest = line.partition("=")
    state, _, restarts = rest.partition("=")
    units[name] = s(state)
    unit_restarts[name] = i(restarts)

ring_files = i(ring_files_count) or 0

out = {
    "model": s(model),
    "hostname": s(hostname_val),
    "uptime_s": i(uptime_s),
    "wlan0": {
        "ssid": s(wlan0_ssid),
        "rssi_dbm": i(wlan0_rssi),
        "bitrate_mbps": f(wlan0_bitrate),
        "power_save": s(wlan0_powersave),
        "ipv4": s(wlan0_ipv4),
        "connected": yesno(wlan0_connected),
    },
    "eth0": {
        "carrier": b01(eth0_carrier),
        "ipv4": s(eth0_ipv4),
        "scanner_lease": scanner_lease,
        "scanner_neigh": s(eth0_neigh),
    },
    # rules/dnat_target are null -- not [] and not "absent" -- when the
    # ruleset could not be read at all, so "nftables is loaded with no rules"
    # (a broken bridge) stays distinguishable from "this probe could not run".
    "nft": {
        "readable": yesno(nft_ok),
        "rules": nft_rules if yesno(nft_ok) else None,
        "dnat_target": dnat_target,
    },
    # ring_files/ring_bytes are null -- not 0 -- when the ring could not be
    # read at all. A zero here tells the operator frames are unrecoverable, so
    # it must never be manufactured from a permission error.
    "tee": {
        "active": s(tee_active) == "active",
        "readable": yesno(tee_readable),
        "ring_files": ring_files if yesno(tee_readable) else None,
        "ring_bytes": i(ring_bytes) if yesno(tee_readable) else None,
        "newest": s(ring_newest),
        "oldest": s(ring_oldest),
    },
    "units": units,
    "unit_restarts": unit_restarts,
    "temp_c": f(temp_c),
    "throttled": s(throttled),
    "ntp_synced": yesno(ntp_synced),
}

json.dump(out, sys.stdout)
print()
' \
    "${MODEL}" "${HOSTNAME_VAL}" "${UPTIME_S}" \
    "${WLAN0_SSID}" "${WLAN0_RSSI}" "${WLAN0_BITRATE}" "${WLAN0_POWERSAVE}" "${WLAN0_IPV4}" "${WLAN0_CONNECTED}" \
    "${ETH0_CARRIER}" "${ETH0_IPV4}" "${ETH0_NEIGH}" "${LEASES_RAW}" \
    "${NFT_RAW}" "${NFT_OK}" \
    "${TEE_ACTIVE}" "${RING_FILES_COUNT}" "${RING_BYTES}" "${RING_NEWEST}" "${RING_OLDEST}" "${TEE_READABLE}" \
    "${UNITS_RAW}" \
    "${TEMP_C}" "${THROTTLED}" "${NTP_SYNCED}" \
    "${SCANNER_IP}" "${STREAM_PORT}"
