#!/bin/bash
# roomscan-bridge-reconcile -- periodic health/self-healing pass for the
# roomscan Wi-Fi<->eth0 bridge. Run every 10s by
# roomscan-bridge-reconcile.timer.
#
# Fail-closed: any unexpected error trips `set -e` and the script exits
# non-zero, which systemd records as a failed run of the oneshot service
# (visible in `systemctl status roomscan-bridge-reconcile.service` and the
# journal) rather than silently doing nothing.

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Pull in shared nft/DNAT helpers and node-identity defaults
# (SCANNER_IP, SCANNER_MAC, SCANNER_FALLBACK_IP, STREAM_PORT, ...),
# overridden by /etc/roomscan-bridge/node.env when present. Try next to
# this script first (matches a payload checkout / pre-install layout),
# then the installed location. If neither is found, fall back to inline
# defaults so this script still runs standalone.
if [ -f "${SELF_DIR}/roomscan-bridge-common.sh" ]; then
    # shellcheck disable=SC1091
    . "${SELF_DIR}/roomscan-bridge-common.sh"
elif [ -f /usr/local/sbin/roomscan-bridge-common.sh ]; then
    # shellcheck disable=SC1091
    . /usr/local/sbin/roomscan-bridge-common.sh
else
    : "${SCANNER_IP:=172.31.100.20}"
    : "${SCANNER_MAC:=00:80:e1:00:00:00}"
    : "${SCANNER_FALLBACK_IP:=172.31.253.1}"
    : "${STREAM_PORT:=5000}"
    [ -f /etc/roomscan-bridge/node.env ] && . /etc/roomscan-bridge/node.env
    NFT_TABLE="ip roomscan_bridge"
    NFT_CHAIN="prerouting"
    DNAT_COMMENT="roomscan-dnat-to-scanner"
    roomscan_dnat_rule_line() { nft list chain ${NFT_TABLE} ${NFT_CHAIN} 2>/dev/null | grep -F "${DNAT_COMMENT}" || true; }
    roomscan_dnat_target_ip() { roomscan_dnat_rule_line | grep -oP 'dnat to \K[0-9.]+(?=:[0-9]+)' || true; }
    roomscan_dnat_counter_bytes() { roomscan_dnat_rule_line | grep -oP 'bytes \K[0-9]+' || true; }
    roomscan_dnat_rule_handle() { nft -a list chain ${NFT_TABLE} ${NFT_CHAIN} 2>/dev/null | grep -F "${DNAT_COMMENT}" | grep -oP 'handle \K[0-9]+' || true; }
    roomscan_set_dnat_target() {
        local new_ip="$1" handle
        handle="$(roomscan_dnat_rule_handle)"
        [ -n "${handle}" ] || return 1
        nft replace rule ${NFT_TABLE} ${NFT_CHAIN} handle "${handle}" \
            iifname "wlan0" udp dport "${STREAM_PORT}" counter dnat to "${new_ip}:${STREAM_PORT}" comment "${DNAT_COMMENT}"
    }
    roomscan_stream_is_live() {
        local sample_secs="${1:-1}" before after
        before="$(roomscan_dnat_counter_bytes)"; [ -n "${before}" ] || before=0
        sleep "${sample_secs}"
        after="$(roomscan_dnat_counter_bytes)"; [ -n "${after}" ] || after=0
        if [ "${after}" -gt "${before}" ]; then echo "yes"; else echo "no"; fi
    }
fi

PROBE_ALIAS_ADDR="${SCANNER_FALLBACK_IP%.*}.2"
PROBE_ALIAS="${PROBE_ALIAS_ADDR}/24"
LEASE_FILE="/var/lib/misc/dnsmasq.leases"

REQUIRED_UNITS=(dnsmasq.service avahi-daemon.service nftables.service roomscan-tee.service)

log() {
    logger -t roomscan-bridge "reconcile: $*"
}

# ---------------------------------------------------------------------------
# Scanner reachability
# ---------------------------------------------------------------------------

scanner_present() {
    if [ -f "${LEASE_FILE}" ] && grep -qi "${SCANNER_IP}" "${LEASE_FILE}"; then
        return 0
    fi
    local state
    state="$(ip neigh show "${SCANNER_IP}" dev eth0 2>/dev/null | awk '{print $NF}' || true)"
    case "${state}" in
        REACHABLE|STALE|DELAY|PERMANENT)
            return 0
            ;;
    esac
    return 1
}

# ---------------------------------------------------------------------------
# Fallback-mode probe
# ---------------------------------------------------------------------------

# Adds a temporary alias on eth0 and pings the scanner's self-assigned
# fallback address. Always removes the alias before returning, even on
# failure. Echoes "yes" or "no" on stdout.
probe_fallback_scanner() {
    local answered="no"
    ip addr add "${PROBE_ALIAS}" dev eth0 2>/dev/null || true
    if ping -c 2 -W 1 "${SCANNER_FALLBACK_IP}" >/dev/null 2>&1; then
        answered="yes"
    fi
    ip addr del "${PROBE_ALIAS}" dev eth0 2>/dev/null || true
    # Touching eth0 with iproute2 is what flips NM into "connected
    # (externally)", after which our static address never (re)applies. Every
    # such path re-asserts it. Emits nothing on stdout, so the echo below is
    # still the only thing this function prints.
    roomscan_ensure_eth0_address
    echo "${answered}"
}

# ---------------------------------------------------------------------------
# Handling for the "scanner absent" branch
# ---------------------------------------------------------------------------

handle_scanner_absent() {
    log "scanner not present at ${SCANNER_IP}, probing fallback mode"
    local answered
    answered="$(probe_fallback_scanner)"
    if [ "${answered}" != "yes" ]; then
        log "fallback probe (${SCANNER_FALLBACK_IP}) did not answer; scanner is simply offline"
        return 0
    fi

    log "scanner answered on fallback address ${SCANNER_FALLBACK_IP}"
    local current_target
    current_target="$(roomscan_dnat_target_ip)"
    if [ "${current_target}" != "${SCANNER_FALLBACK_IP}" ]; then
        log "retargeting DNAT to ${SCANNER_FALLBACK_IP}:${STREAM_PORT}"
        roomscan_set_dnat_target "${SCANNER_FALLBACK_IP}" || log "ERROR: could not retarget DNAT rule"
    else
        log "DNAT already targets ${SCANNER_FALLBACK_IP}"
    fi

    local live
    live="$(roomscan_stream_is_live 2)"
    if [ "${live}" = "yes" ]; then
        log "DNAT counters show live traffic to ${SCANNER_FALLBACK_IP}; NOT bouncing eth0 (capture may be in progress)"
        return 0
    fi

    log "no live traffic observed; bouncing eth0 to push scanner's DHCP client back to INIT"
    ip link set eth0 down
    sleep 1
    ip link set eth0 up
    log "eth0 bounced"
    roomscan_ensure_eth0_address
}

# ---------------------------------------------------------------------------
# Handling for the "scanner present" branch
# ---------------------------------------------------------------------------

handle_scanner_present() {
    local current_target
    current_target="$(roomscan_dnat_target_ip)"
    if [ "${current_target}" = "${SCANNER_FALLBACK_IP}" ]; then
        log "scanner reachable via DHCP at ${SCANNER_IP} but DNAT still points at fallback; restoring"
        roomscan_set_dnat_target "${SCANNER_IP}" || log "ERROR: could not restore DNAT rule to ${SCANNER_IP}"
    fi
}

# ---------------------------------------------------------------------------
# wlan0 health (issue #200)
# ---------------------------------------------------------------------------

# NetworkManager can reach a permanent wlan0 dead-end that nothing else here
# (or in systemd) ever retries: a WPA 4-way-handshake IE mismatch --
# `wpa_supplicant`'s own log reads "IE in 3/4 msg does not match with IE in
# Beacon/ProbeResp", an AP-side race, not a config or driver fault -- makes
# wpa_supplicant locally abort the handshake (reason=17, locally_generated=1).
# NetworkManager's recovery for "disconnected during association" is to ask
# for NEW secrets rather than retry the ones it already has, and on this
# headless box there is no secrets agent to answer that request -- activation
# fails with "no secrets: No agents were available for this request" and
# wlan0 is left `disconnected` indefinitely. This looked identical to the Pi
# being fully hung (issue #200, 2026-08-19) even though the box itself, eth0,
# and the tee were all healthy the entire time; `nmcli connection up
# roomscan-wifi-home` reconnected INSTANTLY on the already-stored credentials
# once someone happened to SSH in over the wired debug NIC and try it -- the
# "no secrets" state was never actually true, it is a NetworkManager
# state-machine dead end, not a missing password. This closes that gap
# without needing a human to notice.
ensure_wlan0_connected() {
    local state
    state="$(nmcli -t -f DEVICE,STATE device status 2>/dev/null | awk -F: '$1=="wlan0"{print $2}')"
    case "${state}" in
        disconnected|failed)
            log "wlan0 is ${state}, asking NetworkManager to reconnect"
            # --wait 10: unbounded nmcli activation can block up to 90s, and
            # this runs from reconcile's serialised 10s timer -- a hung call
            # here must not also stall the scanner-DHCP and unit-health
            # checks that follow it for the next several ticks (same reason
            # roomscan-bridge-common.sh's own `nmcli con up` is bounded).
            if nmcli --wait 10 device connect wlan0 >/dev/null 2>&1; then
                log "wlan0 reconnect requested successfully"
            else
                log "ERROR: nmcli device connect wlan0 failed"
            fi
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Camera (issue #226)
# ---------------------------------------------------------------------------

# Is the C270 actually on the USB bus? Identity, never a /dev/videoN guess:
# the camera exposes TWO nodes with the same USB id and only one of them is a
# capture node, and the numbering moves across replug.
camera_present() {
    if command -v lsusb >/dev/null 2>&1; then
        lsusb 2>/dev/null | grep -qi "046d:0825" && return 0
        return 1
    fi
    local idv idp
    for idv in /sys/bus/usb/devices/*/idVendor; do
        [ -f "${idv}" ] || continue
        idp="$(dirname "${idv}")/idProduct"
        if [ "$(cat "${idv}" 2>/dev/null)" = "046d" ] && \
           [ "$(cat "${idp}" 2>/dev/null)" = "0825" ]; then
            return 0
        fi
    done
    return 1
}

# Restart roomscan-cam ONLY when the camera identity is present.
#
# The asymmetry is the point. With no camera fitted, the daemon is supposed to
# sit in `device_absent` and the unit is supposed to be active, so there is
# nothing to heal -- and hammering `systemctl restart` at a bridge that simply
# has no camera would burn the unit StartLimitBurst on a non-problem and leave
# it dead for the moment a camera IS plugged in. With a camera present and the
# unit dead, that is a real fault and worth one restart per pass.
ensure_camera_service() {
    systemctl list-unit-files roomscan-cam.service >/dev/null 2>&1 || return 0
    if ! camera_present; then
        return 0
    fi
    if systemctl is-active --quiet roomscan-cam.service; then
        return 0
    fi
    log "C270 present but roomscan-cam.service is not active, restarting"
    # reset-failed first: a unit that already burned its StartLimitBurst
    # answers every restart with `Start request repeated too quickly` and never
    # runs again, which is exactly the state a self-healing pass must clear
    # (the lesson roomscan-tee taught in issue #191).
    systemctl reset-failed roomscan-cam.service 2>/dev/null || true
    if systemctl restart roomscan-cam.service; then
        log "restarted roomscan-cam.service successfully"
    else
        log "ERROR: failed to restart roomscan-cam.service"
    fi
}

# ---------------------------------------------------------------------------
# Unit health
# ---------------------------------------------------------------------------

restart_dead_units() {
    local unit
    for unit in "${REQUIRED_UNITS[@]}"; do
        if ! systemctl is-active --quiet "${unit}"; then
            log "unit ${unit} is not active, restarting"
            if systemctl restart "${unit}"; then
                log "restarted ${unit} successfully"
            else
                log "ERROR: failed to restart ${unit}"
            fi
        fi
    done
}

# ---------------------------------------------------------------------------

main() {
    if scanner_present; then
        handle_scanner_present
    else
        handle_scanner_absent
    fi
    restart_dead_units
    ensure_wlan0_connected
    ensure_camera_service
}

main "$@"
